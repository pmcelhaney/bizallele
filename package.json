{
    "name": "bizallele",
    "version": "0.0.2",
    "description": "Genetic code for business rules: declarative fields, records, and recordsets",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        },
        "./lit": {
            "types": "./dist/lit/index.d.ts",
            "default": "./dist/lit/index.js"
        }
    },
    "typesVersions": {
        "*": {
            "lit": [
                "dist/lit/index.d.ts"
            ],
            "dist/*": [
                "dist/*"
            ],
            "*": [
                "dist/*"
            ]
        }
    },
    "files": [
        "dist"
    ],
    "license": "apache-2.0",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node scripts/build-package.mjs",
        "prepack": "npm run build",
        "docs:dev": "vite --config examples/fdl-input/vite.config.mjs examples/fdl-input",
        "docs:build": "vite build --config examples/fdl-input/vite.config.mjs examples/fdl-input",
        "test": "jest",
        "typecheck": "tsc --noEmit",
        "test:watch": "jest --watch",
        "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
        "format": "node scripts/format-example-snippets.mjs && prettier . --write",
        "format:check": "node scripts/format-example-snippets.mjs --check && prettier . --check"
    },
    "dependencies": {
        "@loancrate/prisma-schema-parser": "3.0.0",
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "jsdoc": "^3.6.7",
        "lit": "^2.2.3",
        "ts-jest": "^27.1.3",
        "ts-loader": "^9.3.0",
        "typescript": "^4.6.4",
        "yaml": "2.9.1"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.15.6",
        "@open-wc/testing": "2.5.33",
        "@types/jest": "27.5.2",
        "@types/node": "18.19.50",
        "babel-jest": "^27.2.1",
        "esbuild": "^0.21.5",
        "jest": "^27.2.1",
        "markdown-it": "^12.3.2",
        "prettier": "^3.9.10",
        "regenerator-runtime": "^0.13.9",
        "vite": "^5.4.19"
    },
    "overrides": {
        "errorstacks": "2.4.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pmcelhaney/bizallele.git"
    }
}
